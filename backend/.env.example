# Modelo das variáveis de ambiente. Copie para .env e preencha os valores reais.

DJANGO_SECRET_KEY=gere-com-python-c-import-secrets-print-secrets-token_urlsafe-50
ALIAS_SECRET=gere-com-python-c-import-secrets-print-secrets-token_urlsafe-50
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# postgres://USUARIO:SENHA@ENDERECO:PORTA/BANCO (no Neon, com ?sslmode=require no fim)
DATABASE_URL=postgres://casa_letras:sua-senha@localhost:5432/casa_das_letras

# Chave privada Ed25519 que assina a âncora de cada lote. Nunca coloque a chave real aqui.
# Gere com: python manage.py generate_signing_key  (e cole a linha impressa no .env)
AUDIT_SIGNING_KEY=

# Redis da cópia externa das âncoras: redis://ENDERECO:PORTA/0 (no Upstash, rediss://..., com TLS).
# Vazio desliga a cópia.
REDIS_URL=

# ---- Produção (Render) ----
# No local, deixe estas linhas comentadas: os padrões já servem.

# Segredo que o cron-job.org manda em "Authorization: Bearer <segredo>" no POST /api/internal/tick/.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))". Vazio desliga a rota.
# CRON_SECRET=

# Baixar a capa ao criar um lote (padrão True). No Render, False: lá não há disco permanente.
# COVER_DOWNLOAD=True

# Quantos proxies ficam entre o navegador e o Django (Vercel + Render). Vazio no local.
# DRF_NUM_PROXIES=

# Segundos que uma conexão com o banco é reaproveitada (padrão 0: uma por pedido, como pede o ASGI).
# DJANGO_CONN_MAX_AGE=0

# Cache em um Redis (redis://...). Vazio: cache na memória do processo.
# DJANGO_CACHE_URL=

# Pasta das capas baixadas. Vazio: backend/media.
# DJANGO_MEDIA_ROOT=

# O Render cria esta sozinho com o endereço do serviço; não precisa configurar.
# RENDER_EXTERNAL_HOSTNAME=
