# ---- Segredos ----
# Variáveis de ambiente com senhas e chaves. Nunca vão para o GitHub.
.env
.env.*
# O modelo sem valores reais pode ir, para mostrar quais variáveis existem.
!.env.example

# ---- Python (backend) ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# ---- Django ----
# Arquivos gerados pelo collectstatic e capas baixadas da Open Library.
backend/staticfiles/
backend/media/

# Banco SQLite que o Django cria por padrão; usamos PostgreSQL.
*.sqlite3

# ---- Node (frontend) ----
node_modules/
frontend/dist/
.vercel/

# ---- Editor e sistema operacional ----
.vscode/
.idea/
Thumbs.db
.DS_Store
desktop.ini

# ---- Logs ----
*.log


