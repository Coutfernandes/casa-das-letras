{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://casa-das-letras.onrender.com/api/$1" },
    { "source": "/static/(.*)", "destination": "https://casa-das-letras.onrender.com/static/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
